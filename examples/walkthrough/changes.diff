+depends_on: Union[str, Sequence[str], None] = None
+
+
+def upgrade() -> None:
+    op.execute("SET lock_timeout = '3s'")
+    op.execute("SET statement_timeout = '30s'")
+    # Nullable, no default: metadata-only. NULL means "no deduction" (= 0 kg).
+    op.add_column(
+        "orders",
+        sa.Column("grade_deduction_kg", sa.Numeric(14, 3), nullable=True),
+    )
+    # NOT VALID so no table scan happens under this lock; 0006 validates.
+    op.execute(
+        "ALTER TABLE orders ADD CONSTRAINT ck_orders_grade_deduction_nonneg "
+        "CHECK (grade_deduction_kg IS NULL OR grade_deduction_kg >= 0) NOT VALID"
+    )
+    op.execute(
+        "ALTER TABLE orders ADD CONSTRAINT ck_orders_grade_deduction_le_net "
+        "CHECK (grade_deduction_kg IS NULL OR grade_deduction_kg <= net_weight_kg) NOT VALID"
+    )
+
+
+def downgrade() -> None:
+    op.execute("SET lock_timeout = '3s'")
+    op.execute("SET statement_timeout = '30s'")
+    op.execute("ALTER TABLE orders DROP CONSTRAINT ck_orders_grade_deduction_le_net")
+    op.execute("ALTER TABLE orders DROP CONSTRAINT ck_orders_grade_deduction_nonneg")
+    op.drop_column("orders", "grade_deduction_kg")
