+def test_accepted_weight_subtracts_deduction():
+    assert accepted_weight_kg(order(weight="1000.000", deduction="12.500")) == Decimal("987.500")
+    assert accepted_weight_kg(order(weight="1000.000", deduction="0")) == Decimal("1000.000")
+    # Full rejection by inspection leaves nothing billable.
+    assert accepted_weight_kg(order(weight="50.000", deduction="50.000")) == Decimal("0.000")
+
+
+def test_null_deduction_means_no_deduction():
+    assert accepted_weight_kg(order(weight="12.345", deduction=None)) == Decimal("12.345")
+
+
+def test_deduction_reduces_order_value_at_unchanged_price():
+    # (1000 - 100) kg x 85 cents
+    assert order_value_cents(order(weight="1000.000", price=85, deduction="100.000")) == 76_500
+
